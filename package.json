{
	"name": "@untemps/utils",
	"version": "3.0.0",
	"description": "Utils for @untemps packages",
	"repository": "git@github.com:untemps/utils.git",
	"keywords": [],
	"author": "Vincent Le Badezet <v.lebadezet@untemps.net>",
	"license": "MIT",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		"./*": {
			"import": "./dist/*.js",
			"require": "./dist/*.cjs"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.0.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.0",
		"@testing-library/dom": "^10.0.0",
		"@testing-library/jest-dom": "^6.0.0",
		"commitlint": "^20.0.0",
		"cross-env": "^10.1.0",
		"docdash": "^2.0.0",
		"fast-check": "^4.0.0",
		"husky": "^9.0.0",
		"jest": "^30.0.0",
		"jest-environment-jsdom": "^30.0.0",
		"jsdoc": "^4.0.0",
		"prettier": "^3.0.0",
		"rimraf": "^6.0.0",
		"semantic-release": "^25.0.0",
		"vite": "^8.0.0"
	},
	"jest": {
		"setupFilesAfterEnv": [
			"<rootDir>/jest-setup.js"
		],
		"testEnvironment": "jsdom",
		"coverageDirectory": "./coverage/",
		"collectCoverage": true,
		"transform": {}
	},
	"release": {
		"branches": [
			"main",
			{
				"name": "beta",
				"prerelease": true
			}
		],
		"plugins": [
			[
				"@semantic-release/commit-analyzer",
				{
					"releaseRules": [
						{
							"type": "chore",
							"scope": "force",
							"release": "patch"
						}
					]
				}
			],
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			"@semantic-release/npm",
			"@semantic-release/git",
			"@semantic-release/github"
		]
	},
	"scripts": {
		"docs": "rimraf docs && jsdoc -c jsdoc.json",
		"test": "yarn node --experimental-vm-modules node_modules/jest/bin/jest.js -u --watchAll",
		"test:ci": "yarn node --experimental-vm-modules node_modules/jest/bin/jest.js -u -b --ci --coverage",
		"build": "rimraf dist && vite build",
		"prettier": "prettier \"*/**/*.js\" --ignore-path ./.prettierignore --write && git add . && git status",
		"prepare": "husky"
	}
}
